<!DOCTYPE html>
<html>
  <head>
    <title><%= [@databases.size > 1 ? @database.name : "PgHero", @title].compact.join(" / ") %></title>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= favicon_link_tag "pghero/favicon.png" %>
    <% if defined?(Propshaft::Railtie) && Rails.application.assets.is_a?(Propshaft::Assembly) %>
      <%= stylesheet_link_tag "pghero/nouislider", "pghero/arduino-light", "pghero/application", "pghero/theme" %>
      <%= javascript_include_tag "pghero/nouislider", "pghero/Chart.bundle", "pghero/chartkick", "pghero/highlight.min", "pghero/application", nonce: true %>
    <% else %>
      <%= stylesheet_link_tag "pghero/application" %>
      <%= javascript_include_tag "pghero/application", nonce: true %>
    <% end %>
  </head>
  <body>
    <div class="ph-layout">
      <aside class="ph-sidebar">
        <div class="ph-brand">
          <span class="ph-brand-mark">Pg</span>
          <%= link_to "PgHero", root_path %>
        </div>

        <nav class="ph-sidebar-nav">
          <ul class="ph-nav">
            <!-- poor man's active_link_to -->
            <li class="<%= controller.action_name == "index" ? "active" : "" %>"><%= link_to root_path do %><%= pghero_nav_icon(:overview) %><span class="ph-nav-label">Overview</span><% end %></li>
            <% if @system_stats_enabled %>
              <li class="<%= controller.action_name == "system" ? "active" : "" %>"><%= link_to system_path do %><%= pghero_nav_icon(:system) %><span class="ph-nav-label">System</span><% end %></li>
            <% end %>
            <% if @query_stats_enabled %>
              <li class="<%= controller.action_name == "queries" ? "active" : "" %>"><%= link_to queries_path do %><%= pghero_nav_icon(:queries) %><span class="ph-nav-label">Queries</span><% end %></li>
            <% end %>
            <li class="<%= controller.action_name == "space" ? "active" : "" %>"><%= link_to space_path do %><%= pghero_nav_icon(:space) %><span class="ph-nav-label">Space</span><% end %></li>
            <li class="<%= controller.action_name == "connections" ? "active" : "" %>"><%= link_to connections_path do %><%= pghero_nav_icon(:connections) %><span class="ph-nav-label">Connections</span><% end %></li>
            <li class="<%= controller.action_name == "live_queries" ? "active" : "" %>"><%= link_to live_queries_path do %><%= pghero_nav_icon(:live_queries) %><span class="ph-nav-label">Live Queries</span><% end %></li>
            <% unless @database.replica? %>
              <li class="<%= controller.action_name == "maintenance" ? "active" : "" %>"><%= link_to maintenance_path do %><%= pghero_nav_icon(:maintenance) %><span class="ph-nav-label">Maintenance</span><% end %></li>
            <% end %>
            <% if @explain_enabled %>
              <li class="<%= controller.action_name == "explain" ? "active" : "" %>"><%= link_to explain_path do %><%= pghero_nav_icon(:explain) %><span class="ph-nav-label">Explain</span><% end %></li>
            <% end %>
            <li class="<%= controller.action_name == "tune" ? "active" : "" %>"><%= link_to tune_path do %><%= pghero_nav_icon(:tune) %><span class="ph-nav-label">Tune</span><% end %></li>
          </ul>
        </nav>

        <% if @databases.size > 1 %>
          <div class="ph-sidebar-section">
            <p class="ph-sidebar-heading">Databases</p>
            <ul class="ph-nav">
              <% @databases.each do |database| %>
                <li class="<%= ("active-database" if @database.id == database.id) %>">
                  <%= link_to database.name, action_name == "show_query" ? root_path(database: database.id) : {database: database.id} %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </aside>

      <div class="ph-main">
        <header class="ph-topbar">
          <h1 class="ph-topbar-title"><%= @title || "PgHero" %></h1>

          <div class="ph-topbar-controls">
            <!-- Placeholder database selector (static for now) -->
            <div class="ph-control ph-control-placeholder">
              <select class="ph-control-select" aria-label="Database (placeholder)" disabled>
                <option><%= @databases.size > 1 ? @database.name : "Database" %></option>
              </select>
            </div>
            <!-- Placeholder time-range selector (static for now) -->
            <div class="ph-control ph-control-placeholder">
              <select class="ph-control-select" aria-label="Time range (placeholder)" disabled>
                <option>Last 24 hours</option>
              </select>
            </div>
          </div>
        </header>

        <div class="ph-content">
          <% if alert || notice || Rails.env.development? %>
            <div class="alert alert-<%= alert ? "danger" : "info" %>">
              <% if alert %>
                <%= alert %>
              <% elsif notice %>
                <%= notice %>
              <% elsif Rails.env.development? %>
                Do not use development information to make decisions about your production environment
              <% end %>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
